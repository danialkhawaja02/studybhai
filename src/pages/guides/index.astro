---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PaginatedResourceGrid from '@/components/PaginatedResourceGrid.astro';
import { getAllPosts } from '@/lib/wordpress';

const allPosts = await getAllPosts();
const guides = allPosts.filter(p => p.categories.includes('student-guides') || p.categories.includes('scholarships'));
---

<Layout 
  title="Student Preparation & Career Guides - Study Bhai"
  description="Comprehensive student roadmaps, USAT preparation books, HEC entrance test guides, and university admission resources in Pakistan."
>
  <Header slot="header" />

  <div class="archive-header">
    <div class="container">
      <nav class="breadcrumb-nav">
        <a href="/">Home</a> <span>/</span> <strong>Student Guides</strong>
      </nav>
      <h1 class="archive-title">Student Guides & Roadmaps</h1>
      <p class="archive-subtitle">
        Expert admission tips, HEC test preparation procedures, and career guidance for college and university students.
      </p>
    </div>
  </div>

  <section class="archive-content">
    <div class="container">
      <PaginatedResourceGrid 
        posts={guides} 
        pageSize={9} 
        emptyTitle="No guides found" 
        emptyDesc="Please browse all resources or check back shortly."
      />
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .archive-header {
    background: linear-gradient(180deg, var(--color-wine) 0%, var(--color-wine-dark) 100%);
    color: #FFFFFF;
    padding: 4.5rem 0 3.5rem;
    position: relative;
    overflow: hidden;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(226, 232, 240, 0.75);
    margin-bottom: 1rem;
  }

  .breadcrumb-nav a {
    color: #8c92ff;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-nav a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .breadcrumb-nav strong {
    color: #FFFFFF;
  }

  .archive-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .archive-subtitle {
    font-size: 1.1rem;
    color: #cbd5e1;
    max-width: 680px;
    margin-bottom: 0;
    line-height: 1.6;
  }

  .archive-content {
    padding: 4.5rem 0;
    background: var(--color-bg);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }
</style>
