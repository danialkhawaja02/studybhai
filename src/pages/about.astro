---
// src/pages/about.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_METADATA } from '@/lib/constants';

const pageTitle = `About Us - ${SITE_METADATA.title}`;
const pageDesc = 'Learn about Study Bhai, our mission to empower Pakistani students with free quality education resources, and our alignment with UN SDG 4.';
---

<Layout title={pageTitle} description={pageDesc}>
  <Header slot="header" />

  <section class="about-hero-section">
    <div class="container">
      <div class="badge-sdg">
        <span class="badge-icon">🎯</span>
        <span>United Nations SDG 4: Quality Education</span>
      </div>
      <h1 class="about-title">Empowering Every Pakistani Student with Free, Quality Education</h1>
      <p class="about-lead">
        Study Bhai was built with a single guiding mission: to ensure that no student across Punjab and Pakistan is held back by the cost of textbooks or access to verified study materials.
      </p>
    </div>
  </section>

  <section class="about-content-section">
    <div class="container about-grid">
      <!-- Main Story -->
      <article class="about-main-card">
        <h2>Our Story</h2>
        <p>
          Founded by <strong>Danial Sohail</strong>, Study Bhai began as a community-driven initiative after recognizing the severe challenges Pakistani matric and intermediate students face: inflated textbook costs, outdated board notes, and fragmented educational content scattered across difficult-to-navigate websites.
        </p>
        <p>
          Today, Study Bhai serves over <strong>500,000+ students</strong> across Lahore, Rawalpindi, Faisalabad, Gujranwala, Multan, and rural districts of Punjab. We provide direct, ultra-fast access to official Punjab Curriculum and Textbook Board (PCTB) books in crisp PDF format, handwritten chapter-wise solved notes, past board examination papers, and international university scholarship guidance.
        </p>

        <div class="mission-callout">
          <div class="mission-icon">💡</div>
          <div>
            <h3>Our Core Belief</h3>
            <p>
              "Quality education is a fundamental human right, not a luxury. When students have unhindered access to verified study material, whole communities transform."
            </p>
          </div>
        </div>

        <h2>What We Provide</h2>
        <div class="offerings-grid">
          <div class="offering-box">
            <span class="offering-num">01</span>
            <h4>Official PTB Textbooks</h4>
            <p>100% verified, clean digital editions of Punjab Board books for 9th, 10th, 1st Year, and 2nd Year.</p>
          </div>
          <div class="offering-box">
            <span class="offering-num">02</span>
            <h4>Chapter-Wise Solved Notes</h4>
            <p>Curated by top board position holders, covering exercises, numericals, and comprehensive theory.</p>
          </div>
          <div class="offering-box">
            <span class="offering-num">03</span>
            <h4>Solved Board Past Papers</h4>
            <p>5-year solved papers and objective keys for BISE Lahore, BISE Gujranwala, BISE Rawalpindi, and more.</p>
          </div>
          <div class="offering-box">
            <span class="offering-num">04</span>
            <h4>Scholarship Guides</h4>
            <p>Step-by-step applications for HEC, PEEF, Hungarian Stipendium, and global fully-funded student grants.</p>
          </div>
        </div>
      </article>

      <!-- Sidebar Quick Stats & Founder -->
      <aside class="about-sidebar">
        <div class="founder-card">
          <div class="founder-avatar">DS</div>
          <h3 class="founder-name">Danial Sohail</h3>
          <p class="founder-role">Founder & Chief Educational Officer</p>
          <p class="founder-bio">
            Passionate educator and technologist committed to bridging Pakistan's digital divide through open-access educational resources.
          </p>
          <div class="founder-socials">
            <a href="https://instagram.com/officialstudybhai" target="_blank" rel="noopener noreferrer" class="social-link">Instagram</a>
            <a href="https://facebook.com/officialstudybhai" target="_blank" rel="noopener noreferrer" class="social-link">Facebook</a>
          </div>
        </div>

        <div class="impact-card">
          <h3>Community Impact</h3>
          <ul class="impact-list">
            <li>
              <span class="impact-val">500,000+</span>
              <span class="impact-label">Pakistani Students Guided</span>
            </li>
            <li>
              <span class="impact-val">15+</span>
              <span class="impact-label">Matric & FSc Subjects Covered</span>
            </li>
            <li>
              <span class="impact-val">100%</span>
              <span class="impact-label">Free & Open Access Forever</span>
            </li>
            <li>
              <span class="impact-val">0.3s</span>
              <span class="impact-label">Instant High-Speed CDN Delivery</span>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .about-hero-section {
    padding: 70px 0 50px;
    background: linear-gradient(180deg, #FFE7DB 0%, #FCF7EF 100%);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .badge-sdg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFDFB;
    border: 1px solid var(--color-border);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-wine);
    margin-bottom: 20px;
    box-shadow: var(--shadow-sm);
  }

  .about-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--color-wine-dark);
    letter-spacing: -0.02em;
    max-width: 820px;
    margin: 0 auto 16px;
    line-height: 1.2;
  }

  .about-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .about-content-section {
    padding: 60px 0 80px;
    background: var(--color-bg);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 40px;
    align-items: flex-start;
  }

  .about-main-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 36px 40px;
    box-shadow: var(--shadow-sm);
  }

  .about-main-card h2 {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--color-wine-dark);
    margin: 32px 0 16px;
    letter-spacing: -0.01em;
  }

  .about-main-card h2:first-of-type {
    margin-top: 0;
  }

  .about-main-card p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .about-main-card strong {
    color: var(--color-wine-dark);
  }

  .mission-callout {
    display: flex;
    gap: 16px;
    background: #FFE7DB;
    border-left: 4px solid var(--color-wine);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 20px;
    margin: 28px 0;
  }

  .mission-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .mission-callout h3 {
    font-size: 1.1rem;
    margin: 0 0 6px 0;
    color: var(--color-wine);
  }

  .mission-callout p {
    margin: 0;
    font-style: italic;
    color: var(--color-text);
    font-size: 0.98rem;
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 20px;
  }

  .offering-box {
    background: #FFFDFB;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 20px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .offering-box:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .offering-num {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-wine);
    margin-bottom: 8px;
  }

  .offering-box h4 {
    margin: 0 0 8px 0;
    font-size: 1rem;
    color: var(--color-wine-dark);
  }

  .offering-box p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Sidebar */
  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .founder-card,
  .impact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 28px;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .founder-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-wine), #8C243B);
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    border: 3px solid var(--color-peach);
  }

  .founder-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-wine-dark);
    margin: 0 0 4px 0;
  }

  .founder-role {
    font-size: 0.85rem;
    color: var(--color-wine);
    font-weight: 600;
    margin: 0 0 14px 0;
  }

  .founder-bio {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 18px;
  }

  .founder-socials {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  .social-link {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: #FFFDFB;
    border: 1px solid var(--color-border);
    color: var(--color-wine-dark);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .social-link:hover {
    border-color: var(--color-wine);
    color: var(--color-wine);
  }

  .impact-card {
    text-align: left;
  }

  .impact-card h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 16px 0;
    color: var(--color-wine-dark);
  }

  .impact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .impact-list li {
    display: flex;
    flex-direction: column;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--color-border);
  }

  .impact-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .impact-val {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-wine);
  }

  .impact-label {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .offerings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
