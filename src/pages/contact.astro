---
// src/pages/contact.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_METADATA } from '@/lib/constants';

const pageTitle = `Contact Us - ${SITE_METADATA.title}`;
const pageDesc = 'Have questions, need help finding a textbook, or want to contribute educational notes? Get in touch with the Study Bhai support team.';
---

<Layout title={pageTitle} description={pageDesc}>
  <Header slot="header" />

  <section class="contact-hero-section">
    <div class="container">
      <h1 class="contact-title">We'd Love to Hear From You</h1>
      <p class="contact-lead">
        Need help locating a specific Punjab Board chapter, reporting a broken PDF link, or requesting past papers? Reach out to our community team anytime.
      </p>
    </div>
  </section>

  <section class="contact-content-section">
    <div class="container contact-grid">
      <!-- Contact Form -->
      <div class="contact-form-card">
        <h2>Send Us a Message</h2>
        <p class="form-instruction">Fill out the form below and our team will get back to you within 24 to 48 hours.</p>

        <form class="contact-form" id="contact-form" action="#" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="contact-name">Your Full Name *</label>
              <input type="text" id="contact-name" name="name" required placeholder="e.g. Ali Ahmed" />
            </div>
            <div class="form-group">
              <label for="contact-email">Email Address *</label>
              <input type="email" id="contact-email" name="email" required placeholder="name@example.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="contact-grade">Student Grade / Level</label>
              <select id="contact-grade" name="grade">
                <option value="class-9">Class 9 (Matric Part 1)</option>
                <option value="class-10">Class 10 (Matric Part 2)</option>
                <option value="class-11">Class 11 (FSc / ICS 1st Year)</option>
                <option value="class-12">Class 12 (FSc / ICS 2nd Year)</option>
                <option value="university">University / Higher Education</option>
                <option value="other">Teacher / Parent / Other</option>
              </select>
            </div>
            <div class="form-group">
              <label for="contact-subject">Inquiry Subject *</label>
              <input type="text" id="contact-subject" name="subject" required placeholder="e.g. Broken download link or Note request" />
            </div>
          </div>

          <div class="form-group">
            <label for="contact-message">Your Message *</label>
            <textarea id="contact-message" name="message" rows="5" required placeholder="Describe the book, chapter, or question you have..."></textarea>
          </div>

          <button type="submit" class="submit-btn" id="submit-btn">
            <span>Send Message</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>

        <div id="form-success-banner" class="success-banner" style="display: none;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <div>
            <strong>Message Received!</strong>
            <p>Thank you for reaching out. We will get back to you shortly.</p>
          </div>
        </div>
      </div>

      <!-- Contact Info & FAQs -->
      <aside class="contact-sidebar">
        <div class="info-card">
          <h3>Direct Channels</h3>
          
          <div class="info-item">
            <div class="info-icon">✉️</div>
            <div>
              <span class="info-title">Support Email</span>
              <a href="mailto:support@studybhai.com" class="info-link">support@studybhai.com</a>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon">📸</div>
            <div>
              <span class="info-title">Instagram</span>
              <a href="https://instagram.com/officialstudybhai" target="_blank" rel="noopener noreferrer" class="info-link">@officialstudybhai</a>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon">👥</div>
            <div>
              <span class="info-title">Facebook Community</span>
              <a href="https://facebook.com/officialstudybhai" target="_blank" rel="noopener noreferrer" class="info-link">Study Bhai Official</a>
            </div>
          </div>
        </div>

        <div class="faq-card">
          <h3>Quick FAQ</h3>
          
          <div class="faq-item">
            <h4>Are all downloads 100% free?</h4>
            <p>Yes. Study Bhai does not charge a single rupee for textbooks, chapter notes, or past papers.</p>
          </div>

          <div class="faq-item">
            <h4>How can I contribute my study notes?</h4>
            <p>If you're a board position holder or teacher, send your notes to our email with your credentials to be featured.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBanner = document.getElementById('form-success-banner');

  if (form && successBanner) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Client validation demonstration
      form.style.display = 'none';
      successBanner.style.display = 'flex';
    });
  }
</script>

<style>
  .contact-hero-section {
    padding: 70px 0 50px;
    background: linear-gradient(180deg, #f0f3fa 0%, #ffffff 100%);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .contact-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--color-wine-dark);
    letter-spacing: -0.02em;
    margin: 0 0 16px 0;
  }

  .contact-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .contact-content-section {
    padding: 60px 0 80px;
    background: var(--color-bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 40px;
    align-items: flex-start;
  }

  .contact-form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 36px 40px;
    box-shadow: var(--shadow-sm);
  }

  .contact-form-card h2 {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-wine-dark);
    margin: 0 0 8px 0;
  }

  .form-instruction {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 28px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-wine-dark);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 12px 14px;
    background: #FFFDFB;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.95rem;
    transition: all 0.15s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-wine);
    box-shadow: 0 0 0 3px rgba(88, 12, 29, 0.12);
  }

  .submit-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-wine);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 14px 28px;
    border-radius: var(--radius-full);
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 8px;
  }

  .submit-btn:hover {
    background: var(--color-wine-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(85, 93, 227, 0.3);
  }

  .success-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: var(--radius-lg);
    padding: 24px;
    color: #065f46;
  }

  .success-banner strong {
    display: block;
    font-size: 1.1rem;
    margin-bottom: 4px;
    color: #047857;
  }

  .success-banner p {
    margin: 0;
    color: var(--color-text);
  }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .info-card,
  .faq-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 28px;
    box-shadow: var(--shadow-sm);
  }

  .info-card h3,
  .faq-card h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 20px 0;
    color: var(--color-wine-dark);
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 20px;
  }

  .info-item:last-child {
    margin-bottom: 0;
  }

  .info-icon {
    font-size: 1.3rem;
  }

  .info-title {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: 2px;
  }

  .info-link {
    color: var(--color-wine);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  .faq-item {
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--color-border);
  }

  .faq-item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .faq-item h4 {
    margin: 0 0 6px 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-wine-dark);
  }

  .faq-item p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
