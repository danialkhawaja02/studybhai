---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import MarqueeBanner from '@/components/MarqueeBanner.astro';
import Testimonials from '@/components/Testimonials.astro';
import { getAllPosts } from '@/lib/wordpress';

// Fetch all posts for home page
const allPosts = await getAllPosts();

// Split posts by category for dedicated home page sections
const featuredNotes = allPosts.filter(p => p.categories.includes('notes') || p.categories.includes('12th-class-notes')).slice(0, 3);
const featuredBooks = allPosts.filter(p => p.categories.includes('ptb-books') || p.categories.includes('class-9-books') || p.categories.includes('class-10-books')).slice(0, 3);
const latestGuides = allPosts.filter(p => p.categories.includes('student-guides') || p.categories.includes('scholarships')).slice(0, 3);
---

<Layout 
  title="Study Bhai - Your Gateway to Quality Education for All Pakistani Students"
  description="Study Bhai is an online platform for Pakistani students to access quality education resources: PTB textbooks, chapter notes, past papers, and scholarships."
>
  <Header slot="header" />

  <!-- Cadmus Wine Hero with 4-Card Floating Showcase -->
  <Hero />

  <!-- Section 1: Top Chapter Notes on Warm Parchment -->
  <section class="cadmus-section" id="featured-notes">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="badge-pill badge-green">Exam Focused</span>
          <h2 class="section-title">
            Top Quality <span class="italic-serif">Chapter Notes</span>
          </h2>
          <p class="section-lead">Comprehensive chapter-wise revision notes prepared by board position holders.</p>
        </div>
        <a href="/notes/" class="btn-cadmus-outline">
          <span>View All Notes</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>

      <div class="cards-grid-3">
        {featuredNotes.map((post) => (
          <ResourceCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Cadmus Value Propositions & Feature Highlights on Light Peach Tint -->
  <FeatureGrid />

  <!-- Section 3: Official PTB Board Textbooks on Warm Parchment -->
  <section class="cadmus-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="badge-pill badge-peach">Official Curriculum</span>
          <h2 class="section-title">
            Punjab Board <span class="italic-serif">Official Textbooks</span>
          </h2>
          <p class="section-lead">Download high-resolution Punjab Curriculum & Textbook Board (PCTB) digital books.</p>
        </div>
        <a href="/books/" class="btn-cadmus-outline">
          <span>Explore All Textbooks</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>

      <div class="cards-grid-3">
        {featuredBooks.map((post) => (
          <ResourceCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Cadmus Animated Marquee Banner -->
  <MarqueeBanner />

  <!-- Section 5: Student Feedback & Testimonials -->
  <Testimonials />

  <!-- Section 6: Latest Guides & Scholarships -->
  <section class="cadmus-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="badge-pill badge-pink">Guidance & Funding</span>
          <h2 class="section-title">
            University Guides & <span class="italic-serif">Scholarships</span>
          </h2>
          <p class="section-lead">Application roadmaps for USAT, HEC entrance tests, and European fully-funded grants.</p>
        </div>
        <a href="/guides/" class="btn-cadmus-outline">
          <span>Explore All Guides</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>

      <div class="cards-grid-3">
        {latestGuides.map((post) => (
          <ResourceCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Cadmus Wine Footer -->
  <Footer slot="footer" />
</Layout>

<style>
  .cadmus-section {
    padding: 85px 0;
    background-color: var(--color-bg-parchment);
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 800;
    margin: 8px 0 6px 0;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .section-title .italic-serif {
    color: var(--color-wine);
  }

  .section-lead {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 0;
    max-width: 620px;
    line-height: 1.6;
  }

  .cards-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  @media (max-width: 1024px) {
    .cards-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .cards-grid-3 {
      grid-template-columns: 1fr;
    }
    .cadmus-section {
      padding: 60px 0;
    }
  }
</style>
