---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import { getAllPosts } from '@/lib/wordpress';

const allPosts = await getAllPosts();
const scholarships = allPosts.filter(p => p.categories.includes('scholarships'));
---

<Layout 
  title="Fully Funded Scholarships for Pakistani Students - Study Bhai"
  description="Explore fully funded undergraduate, master's, and PhD scholarships for Pakistani students: HEC Stipendium Hungaricum, Turkiye Burslari, Chevening, and domestic talent awards."
>
  <Header slot="header" />

  <div class="archive-header">
    <div class="container">
      <nav class="breadcrumb-nav">
        <a href="/">Home</a> <span>/</span> <strong>Scholarships</strong>
      </nav>
      <h1 class="archive-title">Scholarships & Grants</h1>
      <p class="archive-subtitle">
        Verified procedures, eligibility criteria, and deadline alerts for government and international student scholarships.
      </p>
    </div>
  </div>

  <section class="archive-content">
    <div class="container">
      {scholarships.length > 0 ? (
        <div class="grid-3col">
          {scholarships.map((s) => (
            <ResourceCard post={s} />
          ))}
        </div>
      ) : (
        <div class="empty-state card-premium">
          <h3>No scholarships listed</h3>
          <p>Please browse all student guides or check back shortly.</p>
        </div>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .archive-header {
    background: linear-gradient(180deg, var(--color-wine) 0%, var(--color-wine-dark) 100%);
    color: #FFFFFF;
    padding: 4.5rem 0 3.5rem;
    position: relative;
    overflow: hidden;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255, 231, 219, 0.7);
    margin-bottom: 1rem;
  }

  .breadcrumb-nav a {
    color: var(--color-peach);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-nav a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .breadcrumb-nav strong {
    color: #FFFFFF;
  }

  .archive-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .archive-subtitle {
    font-size: 1.1rem;
    color: var(--color-peach-light);
    max-width: 680px;
    margin-bottom: 0;
    line-height: 1.6;
  }

  .archive-content {
    padding: 4.5rem 0;
    background: var(--color-bg);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }
</style>
