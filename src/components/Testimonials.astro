---
// src/components/Testimonials.astro
import { STUDENT_TESTIMONIALS } from '@/lib/constants';
---

<section class="testimonials-cadmus-section">
  <div class="container">
    <div class="testimonials-header">
      <span class="badge-pill badge-peach">Verified Student Voice</span>
      <h2 class="testimonials-title">
        Trusted by Over 500,000 <span class="italic-serif">Pakistani Students</span>
      </h2>
      <p class="testimonials-subtitle">
        Real feedback from Matric and Intermediate students across Punjab boards who prepare with Study Bhai resources.
      </p>
    </div>

    <div class="testimonials-grid">
      <!-- Highlight Card with 100% Stat -->
      <div class="stat-highlight-card vellum-card">
        <span class="highlight-label">Student Success</span>
        <div class="highlight-big">100%</div>
        <div class="highlight-tag">Free & Open Access</div>
        <p class="highlight-desc">
          Every textbook, handwritten chapter note, and past paper solution on Study Bhai is delivered directly without paywalls or subscriptions.
        </p>
        <div class="satisfaction-badge">
          <span>★★★★★</span>
          <span>4.9 / 5 Average Rating</span>
        </div>
      </div>

      <!-- Testimonial Quote Cards -->
      <div class="quotes-column">
        {STUDENT_TESTIMONIALS.map((item, idx) => {
          const badgeClass = idx === 0 ? 'badge-blue' : idx === 1 ? 'badge-green' : 'badge-lavender';
          return (
            <div class="quote-card vellum-card">
              <div class="quote-top">
                <span class={`badge-pill ${badgeClass}`}>{item.grade}</span>
                <span class="quote-stars">{'★'.repeat(item.rating)}</span>
              </div>
              <p class="quote-body">"{item.quote}"</p>
              <div class="quote-author">
                <div class="author-circle">{item.name.charAt(0)}</div>
                <div>
                  <span class="author-name">{item.name}</span>
                  <span class="author-board">Verified Student</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-cadmus-section {
    background-color: var(--color-bg-parchment);
    padding: 90px 0;
    border-bottom: 1px solid var(--color-vellum-border);
  }

  .testimonials-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 54px;
  }

  .testimonials-header .badge-pill {
    margin-bottom: 14px;
  }

  .testimonials-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    font-weight: 800;
    color: var(--color-text-main);
    line-height: 1.15;
    margin-bottom: 14px;
  }

  .testimonials-title .italic-serif {
    color: var(--color-brand-blue, #555de3);
  }

  .testimonials-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 32px;
    align-items: flex-start;
  }

  /* Stat Highlight Card */
  .stat-highlight-card {
    background: var(--color-navy, #1e2454);
    border: 1px solid var(--color-navy-dark, #131738);
    border-radius: var(--radius-lg);
    padding: 38px 32px;
    color: #ffffff;
    box-shadow: var(--shadow-card);
  }

  .highlight-label {
    display: inline-block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8c92ff;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .highlight-big {
    font-family: var(--font-heading);
    font-size: 3.8rem;
    font-weight: 800;
    color: #8c92ff;
    line-height: 1;
    margin-bottom: 6px;
  }

  .highlight-tag {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .highlight-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 24px;
  }

  .satisfaction-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(182, 219, 255, 0.25);
    padding: 8px 14px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    color: #ffffff;
    font-weight: 600;
  }

  /* Quotes Column */
  .quotes-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .quote-card {
    background: var(--color-surface);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-normal);
  }

  .quote-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .quote-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .quote-stars {
    color: #f59e0b;
    font-size: 0.95rem;
    letter-spacing: 2px;
  }

  .quote-body {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-text-main);
    font-style: italic;
    margin-bottom: 16px;
  }

  .quote-author {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px dashed var(--color-vellum-border);
    padding-top: 12px;
  }

  .author-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-royal-light, #eef0fd);
    color: var(--color-brand-blue, #555de3);
    font-weight: 800;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(85, 93, 227, 0.3);
  }

  .author-name {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .author-board {
    display: block;
    font-size: 0.76rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
