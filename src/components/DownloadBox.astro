---
// src/components/DownloadBox.astro
interface Props {
  title: string;
  fileSize?: string;
  board?: string;
  downloadUrl?: string;
  grade?: string;
}

const {
  title,
  fileSize = '18.4 MB',
  board = 'Punjab Curriculum & Textbook Board (PCTB)',
  downloadUrl = '#',
  grade = 'HSSC / SSC'
} = Astro.props;
---

<div class="download-box-wrapper vellum-card">
  <div class="download-box-header">
    <div class="download-icon-box">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="12" y1="18" x2="12" y2="12"></line>
        <line x1="9" y1="15" x2="15" y2="15"></line>
      </svg>
    </div>
    <div class="download-header-info">
      <div class="download-badge-row">
        <span class="badge-pill badge-green">Official Curriculum</span>
        <span class="badge-pill badge-peach">Verified PDF</span>
      </div>
      <h3 class="download-title">{title}</h3>
    </div>
  </div>

  <div class="download-meta-grid">
    <div class="meta-item">
      <span class="meta-label">Accreditation:</span>
      <span class="meta-val">{board}</span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Format:</span>
      <span class="meta-val">Digital PDF (Printable)</span>
    </div>
    <div class="meta-item">
      <span class="meta-label">File Size:</span>
      <span class="meta-val">{fileSize}</span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Access Cost:</span>
      <span class="meta-val text-free">100% Free Forever</span>
    </div>
  </div>

  <div class="download-action-row">
    <a href={downloadUrl} class="btn-cadmus-primary download-btn" download>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      <span>Download Official PDF ({fileSize})</span>
    </a>
    <div class="safety-indicator">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <span>Verified Virus-Free & Official Source</span>
    </div>
  </div>
</div>

<style>
  .download-box-wrapper {
    background: var(--color-surface);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    margin: 28px 0;
    box-shadow: var(--shadow-card);
  }

  .download-box-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
  }

  .download-icon-box {
    width: 50px;
    height: 50px;
    border-radius: var(--radius-md);
    background: var(--color-royal-light, #eef0fd);
    color: var(--color-brand-blue, #555de3);
    border: 1px solid rgba(85, 93, 227, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .download-header-info {
    flex: 1;
  }

  .download-badge-row {
    display: flex;
    gap: 8px;
    margin-bottom: 6px;
  }

  .download-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .download-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 24px;
    background: var(--color-bg-parchment);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    margin-bottom: 20px;
  }

  @media (max-width: 640px) {
    .download-meta-grid {
      grid-template-columns: 1fr;
    }
  }

  .meta-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
  }

  .meta-label {
    color: var(--color-text-muted);
  }

  .meta-val {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .text-free {
    color: var(--color-brand-blue, #555de3);
    font-weight: 700;
  }

  .download-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .download-btn {
    width: 100%;
    max-width: 360px;
    box-shadow: 0 4px 14px rgba(85, 93, 227, 0.3);
  }

  .safety-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .safety-indicator svg {
    color: #059669;
  }
</style>
