---
// src/components/Header.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const NAV_LINKS = [
  { label: 'Books', href: '/books/' },
  { label: 'Notes', href: '/notes/' },
  { label: 'Past Papers', href: '/past-papers/' },
  { label: 'Scholarships', href: '/scholarships/' },
];
---

<header class="header-island-wrapper">
  <div class="header-island">
    <!-- Brand Logo -->
    <a href="/" class="header-logo" aria-label="Study Bhai Home">
      <div class="logo-emblem">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-0.5-.05"></path>
          <path d="M6 2v20"></path>
          <path d="M10 8h6"></path>
          <path d="M10 12h4"></path>
        </svg>
      </div>
      <div class="logo-text-block">
        <span class="logo-title">Study<span class="logo-wine">Bhai</span></span>
      </div>
    </a>

    <!-- Desktop Navigation (De-congested 4 Links) -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        {NAV_LINKS.map(item => (
          <li>
            <a
              href={item.href}
              class={`nav-link ${currentPath.startsWith(item.href) ? 'is-active' : ''}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Search + Wine CTA) -->
    <div class="header-actions">
      <button type="button" class="search-trigger-pill" data-open-search aria-label="Search resources (Ctrl+K)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-label">Search</span>
        <kbd class="kbd-badge">⌘K</kbd>
      </button>

      <a href="/books/" class="btn-header-wine">
        <span>Get Free Notes</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="mobile-menu-btn"
        id="mobile-menu-toggle"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
      >
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay & Panel -->
  <div class="mobile-nav-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="drawer-overlay" id="mobile-drawer-overlay"></div>
    <div class="drawer-panel">
      <div class="drawer-header">
        <span class="drawer-logo">Study<span>Bhai</span></span>
        <button type="button" class="drawer-close-btn" id="mobile-drawer-close" aria-label="Close menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="drawer-nav">
        <ul class="drawer-links">
          {NAV_LINKS.map(item => (
            <li>
              <a href={item.href} class="drawer-link">{item.label}</a>
            </li>
          ))}
          <li class="drawer-divider"></li>
          <li>
            <a href="/about/" class="drawer-link-sub">About Us</a>
          </li>
          <li>
            <a href="/contact/" class="drawer-link-sub">Contact & Help</a>
          </li>
        </ul>
      </nav>

      <div class="drawer-footer">
        <button type="button" class="drawer-search-btn" data-open-search>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Search Books & Notes...</span>
        </button>
        <a href="/books/" class="btn-drawer-cta">Explore Free Library</a>
      </div>
    </div>
  </div>
</header>

<style>
  .header-island-wrapper {
    position: sticky;
    top: 14px;
    z-index: 1000;
    width: 100%;
    padding: 0 16px;
    pointer-events: none;
  }

  .header-island {
    pointer-events: auto;
    max-width: 920px;
    margin: 0 auto;
    background-color: var(--color-surface);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-lg);
    box-shadow: 1px 8px 18px 0 hsla(26, 28%, 75%, 0.2);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    transition: all var(--transition-normal);
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-emblem {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background-color: var(--color-wine);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .header-logo:hover .logo-emblem {
    transform: scale(1.04);
  }

  .logo-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-main);
  }

  .logo-wine {
    color: var(--color-wine);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-text-main);
    text-decoration: none;
    position: relative;
    padding: 4px 0;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-wine);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-wine);
    transition: width var(--transition-normal);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-trigger-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-bg-parchment);
    border: 1px solid var(--color-vellum-border);
    padding: 7px 12px;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .search-trigger-pill:hover {
    border-color: var(--color-wine);
    color: var(--color-text-main);
    background: #ffffff;
  }

  .kbd-badge {
    background: var(--color-surface);
    border: 1px solid var(--color-vellum-border);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 0.72rem;
    font-family: inherit;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .btn-header-wine {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-wine);
    color: #ffffff;
    padding: 8px 18px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-header-wine:hover {
    background-color: var(--color-wine-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(88, 12, 29, 0.25);
  }

  /* Mobile Button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 8px;
  }

  .bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-main);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 2000;
    pointer-events: auto;
  }

  .mobile-nav-drawer.active {
    display: block;
  }

  .drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(4, 25, 31, 0.6);
    backdrop-filter: blur(4px);
  }

  .drawer-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 320px;
    height: 100%;
    background: var(--color-surface);
    border-left: 1px solid var(--color-vellum-border);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    padding: 24px;
    animation: drawerSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawerSlide {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-vellum-border);
    margin-bottom: 20px;
  }

  .drawer-logo {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .drawer-logo span {
    color: var(--color-wine);
  }

  .drawer-close-btn {
    background: transparent;
    border: none;
    color: var(--color-text-main);
    cursor: pointer;
    padding: 4px;
  }

  .drawer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .drawer-link {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-main);
    display: block;
    padding: 6px 0;
  }

  .drawer-link:hover {
    color: var(--color-wine);
  }

  .drawer-divider {
    height: 1px;
    background: var(--color-vellum-border);
    margin: 8px 0;
  }

  .drawer-link-sub {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    display: block;
    padding: 4px 0;
  }

  .drawer-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 20px;
  }

  .drawer-search-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: var(--color-bg-parchment);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .btn-drawer-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    background: var(--color-wine);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
    text-align: center;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }

    .btn-header-wine {
      display: none;
    }

    .search-label, .kbd-badge {
      display: none;
    }

    .search-trigger-pill {
      padding: 8px;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>

<script>
  function initHeaderDrawer() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const overlay = document.getElementById('mobile-drawer-overlay');

    if (!toggleBtn || !drawer) return;

    function open() {
      drawer?.classList.add('active');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      drawer?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      drawer?.classList.remove('active');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      drawer?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    overlay?.addEventListener('click', close);
  }

  initHeaderDrawer();
  document.addEventListener('astro:page-load', initHeaderDrawer);
</script>
