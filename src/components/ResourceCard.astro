---
// src/components/ResourceCard.astro
import type { Post } from '@/types';
import { extractPostMetadata } from '@/lib/resource-utils';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const meta = extractPostMetadata(post);

// Map subjects to Cadmus pastel pill classes
const getPastelTagClass = (subject: string) => {
  const s = subject.toLowerCase();
  if (s.includes('math')) return 'badge-yellow';
  if (s.includes('physic')) return 'badge-blue';
  if (s.includes('chem')) return 'badge-yellow';
  if (s.includes('bio')) return 'badge-green';
  if (s.includes('english') || s.includes('urdu') || s.includes('pak')) return 'badge-lavender';
  if (s.includes('scholarship') || s.includes('guide')) return 'badge-pink';
  return 'badge-peach';
};
---

<article class="cadmus-card vellum-card">
  <a href={`/${post.slug}/`} class="card-link" aria-label={`Read ${post.title}`}>
    <!-- Thumbnail Media -->
    <div class="card-media">
      {post.featuredImage ? (
        <img 
          src={post.featuredImage.src} 
          alt={post.featuredImage.alt || post.title} 
          loading="lazy" 
          decoding="async"
          class="card-img"
        />
      ) : (
        <div class="card-media-fallback">
          <div class="fallback-icon">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <span class="fallback-text">{meta.subject}</span>
        </div>
      )}

      <!-- Badges -->
      <div class="card-badges">
        <span class={`badge-pill ${getPastelTagClass(meta.subject)} subject-badge`}>
          {meta.subject}
        </span>
        <span class="badge-pill badge-peach">
          {meta.grade}
        </span>
      </div>
    </div>

    <!-- Body -->
    <div class="card-body">
      <div class="card-meta">
        <span class="meta-time">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {meta.readTime}
        </span>
        <span class="meta-board">{meta.board?.split(' ')[0] || 'PCTB'} Verified</span>
      </div>

      <h3 class="card-title">
        {post.title}
      </h3>

      <p class="card-excerpt">
        {post.excerpt.length > 110 ? `${post.excerpt.substring(0, 110)}...` : post.excerpt}
      </p>

      <!-- Footer -->
      <div class="card-footer">
        <div class="card-author">
          <img 
            src={post.author.avatar} 
            alt={post.author.name} 
            class="author-img" 
            width="22" 
            height="22"
            loading="lazy"
          />
          <span class="author-label">{post.author.name}</span>
        </div>

        <span class="card-cta-btn">
          <span>Get Free PDF</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .cadmus-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-lg);
    box-shadow: 1px 8px 12px hsla(31, 24%, 75%, 0.14);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
    overflow: hidden;
  }

  .cadmus-card:hover {
    transform: translateY(-4px);
    box-shadow: 1px 14px 24px hsla(31, 24%, 70%, 0.22);
    border-color: rgba(85, 93, 227, 0.45);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Media */
  .card-media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #f4ecdf;
    overflow: hidden;
    border-bottom: 1px solid var(--color-vellum-border);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .cadmus-card:hover .card-img {
    transform: scale(1.03);
  }

  .card-media-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5ebd8 0%, #ebe0cb 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--color-brand-blue, #555de3);
  }

  .fallback-icon {
    opacity: 0.8;
  }

  .fallback-text {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-blue, #555de3);
  }

  .card-badges {
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: flex;
    gap: 6px;
    z-index: 2;
  }

  /* Body */
  .card-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.74rem;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }

  .meta-time {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .meta-board {
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-brand-blue, #555de3);
    letter-spacing: 0.03em;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 8px;
    color: var(--color-text-main);
    transition: color var(--transition-fast);
  }

  .cadmus-card:hover .card-title {
    color: var(--color-brand-blue, #555de3);
  }

  .card-excerpt {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin-bottom: 18px;
    flex: 1;
  }

  /* Footer */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px dashed var(--color-vellum-border);
    padding-top: 12px;
  }

  .card-author {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .author-img {
    border-radius: 50%;
    object-fit: cover;
  }

  .author-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .card-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-brand-blue, #555de3);
    transition: transform var(--transition-fast);
  }

  .cadmus-card:hover .card-cta-btn {
    transform: translateX(3px);
  }
</style>
