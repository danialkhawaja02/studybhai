---
import type { Post } from '@/types';
import { extractResourceMeta } from '@/lib/resource-utils';

interface Props {
  post: Post;
  showCategory?: boolean;
}

const { post, showCategory = true } = Astro.props;
const meta = post.meta || extractResourceMeta({ title: post.title, tags: post.tags, content: post.content });

// Subject badge color scheme
const getSubjectColorClass = (subject: string) => {
  const s = subject.toLowerCase();
  if (s.includes('math')) return 'subject-math';
  if (s.includes('physic')) return 'subject-physics';
  if (s.includes('chem')) return 'subject-chemistry';
  if (s.includes('bio')) return 'subject-biology';
  if (s.includes('computer')) return 'subject-computer';
  if (s.includes('scholarship')) return 'subject-scholarship';
  return 'subject-general';
};
---

<article class="resource-card card-premium">
  <a href={`/${post.slug}/`} class="card-link" aria-label={`View ${post.title}`}>
    <!-- Thumbnail Preview / Cover -->
    <div class="card-media">
      {post.featuredImage ? (
        <img 
          src={post.featuredImage.src} 
          alt={post.featuredImage.alt || post.title} 
          loading="lazy" 
          decoding="async"
          class="card-img"
        />
      ) : (
        <div class={`card-media-fallback ${getSubjectColorClass(meta.subject)}`}>
          <div class="fallback-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <span class="fallback-subject">{meta.subject}</span>
        </div>
      )}

      <!-- Subject & Grade Badges floating on card -->
      <div class="media-badges">
        <span class={`badge ${getSubjectColorClass(meta.subject)}`}>
          {meta.subject}
        </span>
        <span class="badge badge-grade">
          {meta.grade}
        </span>
      </div>
    </div>

    <!-- Content Area -->
    <div class="card-body">
      <div class="meta-row">
        <span class="read-time">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {meta.readTime}
        </span>
        <span class="board-badge">{meta.board?.split(' ')[0] || 'PTB'}</span>
      </div>

      <h3 class="card-title">
        {post.title}
      </h3>

      <p class="card-excerpt">
        {post.excerpt.length > 120 ? `${post.excerpt.substring(0, 120)}...` : post.excerpt}
      </p>

      <!-- Card Footer -->
      <div class="card-footer">
        <div class="author-info">
          <img 
            src={post.author.avatar} 
            alt={post.author.name} 
            class="author-avatar" 
            width="24" 
            height="24"
            loading="lazy"
          />
          <span class="author-name">{post.author.name}</span>
        </div>

        <span class="card-action-btn">
          <span>Read & Download</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    background: #FFFFFF;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Media Thumbnail */
  .card-media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #E2E8F0;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .resource-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-media-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .fallback-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
  }

  .fallback-subject {
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .media-badges {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.4rem;
    z-index: 2;
  }

  .badge-grade {
    background: rgba(15, 23, 42, 0.85);
    color: #FFFFFF;
    backdrop-filter: blur(4px);
  }

  /* Subject Color Accents */
  .subject-math {
    background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
    color: #FFFFFF;
  }
  .subject-physics {
    background: linear-gradient(135deg, #7C3AED 0%, #6D28D9 100%);
    color: #FFFFFF;
  }
  .subject-chemistry {
    background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
    color: #FFFFFF;
  }
  .subject-biology {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    color: #FFFFFF;
  }
  .subject-computer {
    background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);
    color: #FFFFFF;
  }
  .subject-scholarship {
    background: linear-gradient(135deg, #D97706 0%, #B45309 100%);
    color: #FFFFFF;
  }
  .subject-general {
    background: linear-gradient(135deg, #475569 0%, #334155 100%);
    color: #FFFFFF;
  }

  /* Body */
  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.65rem;
  }

  .read-time {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .board-badge {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand);
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.65rem;
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .resource-card:hover .card-title {
    color: var(--color-brand);
  }

  .card-excerpt {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    flex: 1;
  }

  /* Footer */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 0.85rem;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .author-avatar {
    border-radius: 50%;
    object-fit: cover;
  }

  .author-name {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .card-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-brand);
    transition: transform var(--transition-fast);
  }

  .resource-card:hover .card-action-btn {
    transform: translateX(3px);
  }
</style>
