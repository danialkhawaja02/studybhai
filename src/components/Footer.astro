---
// src/components/Footer.astro
import Logo from '@/components/Logo.astro';
import { FOOTER_DATA } from '@/lib/constants';
---

<footer class="footer-wine">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Mission -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo">
          <Logo variant="light" size="md" />
        </a>
        <p class="footer-mission">
          Dedicated to UN Sustainable Development Goal 4: empowering every Pakistani student with free, high-speed access to official board textbooks and position holder notes.
        </p>
        <div class="support-box">
          <span class="support-title">Direct Student Inquiries:</span>
          <a href="mailto:support@studybhai.com" class="support-link">support@studybhai.com</a>
        </div>
      </div>

      <!-- Col 2: PTB Books -->
      <div class="footer-col">
        <h4 class="col-title">Punjab Textbooks</h4>
        <ul class="footer-links-list">
          <li><a href="/books/class-9/">Class 9 Books PDF</a></li>
          <li><a href="/books/class-10/">Class 10 Books PDF</a></li>
          <li><a href="/books/class-11/">Class 11 (FSc 1st Year)</a></li>
          <li><a href="/books/class-12/">Class 12 (FSc 2nd Year)</a></li>
          <li><a href="/books/">All PTB Textbooks</a></li>
        </ul>
      </div>

      <!-- Col 3: Solved Notes & Hubs -->
      <div class="footer-col">
        <h4 class="col-title">Study Hubs</h4>
        <ul class="footer-links-list">
          <li><a href="/notes/class-9/">9th Class Notes</a></li>
          <li><a href="/notes/class-10/">10th Class Solved Notes</a></li>
          <li><a href="/notes/class-12/">Class 12 Math & Physics</a></li>
          <li><a href="/past-papers/">Solved Past Papers</a></li>
          <li><a href="/scholarships/">University Scholarships</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter & Community -->
      <div class="footer-col newsletter-col">
        <h4 class="col-title">Stay Updated</h4>
        <p class="newsletter-sub">Receive board paper pairing schemes, date sheets, and scholarship deadlines.</p>
        
        <form class="newsletter-form-cadmus" onsubmit="event.preventDefault(); alert('Subscribed to Study Bhai updates!');">
          <input
            type="email"
            placeholder="Enter student email..."
            required
            class="newsletter-input"
            aria-label="Student email"
          />
          <button type="submit" class="newsletter-btn">
            <span>Subscribe</span>
          </button>
        </form>

        <div class="footer-social-row">
          <a href="https://instagram.com/officialstudybhai" target="_blank" rel="noopener noreferrer" class="social-chip">Instagram</a>
          <a href="https://facebook.com/officialstudybhai" target="_blank" rel="noopener noreferrer" class="social-chip">Facebook</a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <p class="copyright-line">
        © 2026 Study Bhai. Non-profit academic repository for Pakistani students.
      </p>
      <div class="legal-links-row">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-services/">Terms of Services</a>
        <a href="/about/">About Founder</a>
        <a href="/contact/">Contact Us</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-wine {
    background: radial-gradient(circle at 80% 10%, rgba(85, 93, 227, 0.14) 0%, transparent 60%),
                var(--color-navy, #1e2454);
    color: #e2e8f0;
    border-top: 1px solid rgba(85, 93, 227, 0.25);
    padding: 70px 0 30px;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1.25fr;
    gap: 40px;
    margin-bottom: 50px;
  }

  @media (max-width: 990px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 12px;
    text-decoration: none;
  }

  .footer-mission {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 18px;
    max-width: 320px;
  }

  .support-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .support-title {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #8c92ff;
    font-weight: 600;
  }

  .support-link {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .col-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    margin: 0;
  }

  .footer-links-list a {
    color: #cbd5e1;
    font-size: 0.9rem;
    transition: all var(--transition-fast);
  }

  .footer-links-list a:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  /* Newsletter */
  .newsletter-sub {
    font-size: 0.86rem;
    color: #cbd5e1;
    margin-bottom: 14px;
    line-height: 1.5;
  }

  .newsletter-form-cadmus {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }

  .newsletter-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(182, 219, 255, 0.25);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    color: #ffffff;
    font-size: 0.88rem;
    outline: none;
  }

  .newsletter-input::placeholder {
    color: rgba(203, 213, 225, 0.6);
  }

  .newsletter-btn {
    background: var(--color-brand-blue, #555de3);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .newsletter-btn:hover {
    background: var(--color-brand-blue-hover, #434bc9);
    box-shadow: 0 4px 12px rgba(85, 93, 227, 0.35);
  }

  .footer-social-row {
    display: flex;
    gap: 10px;
  }

  .social-chip {
    font-size: 0.78rem;
    font-weight: 600;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(182, 219, 255, 0.25);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .social-chip:hover {
    background: var(--color-brand-blue, #555de3);
    color: #ffffff;
    border-color: var(--color-brand-blue, #555de3);
  }

  /* Bottom */
  .footer-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    border-top: 1px solid rgba(182, 219, 255, 0.15);
    padding-top: 24px;
    font-size: 0.82rem;
    opacity: 0.8;
  }

  .copyright-line {
    margin: 0;
  }

  .legal-links-row {
    display: flex;
    gap: 18px;
  }

  .legal-links-row a {
    color: inherit;
  }

  .legal-links-row a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
</style>
