---
// src/components/MarqueeBanner.astro
const BOARDS = [
  'BISE Lahore',
  'BISE Rawalpindi',
  'BISE Gujranwala',
  'BISE Faisalabad',
  'BISE Multan',
  'BISE Sargodha',
  'BISE Sahiwal',
  'BISE Bahawalpur',
  'Federal Board (FBISE)',
  'Punjab Curriculum & Textbook Board (PCTB)'
];
---

<div class="cadmus-marquee-wrap">
  <div class="marquee-inner">
    <div class="marquee-track">
      {BOARDS.concat(BOARDS).map(board => (
        <div class="marquee-item">
          <span class="board-dot"></span>
          <span class="board-name">{board}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .cadmus-marquee-wrap {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-vellum-border);
    border-bottom: 1px solid var(--color-vellum-border);
    padding: 14px 0;
    overflow: hidden;
  }

  .marquee-inner {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
  }

  .marquee-track {
    display: inline-flex;
    align-items: center;
    gap: 36px;
    animation: scroll 40s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-main);
    font-size: 0.88rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .board-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-wine);
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none !important;
    }
  }
</style>
