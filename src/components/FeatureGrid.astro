---
// src/components/FeatureGrid.astro
import { VALUE_PROPOSITIONS, FEATURE_HIGHLIGHTS } from '@/lib/constants';
---

<section class="value-props-section">
  <div class="container">
    <!-- Editorial Two-Card Value Propostions (01 & 02) -->
    <div class="props-grid">
      {VALUE_PROPOSITIONS.map(prop => (
        <div class="prop-card">
          <span class="prop-number">{prop.number}</span>
          <h2 class="prop-title">{prop.title}</h2>
          <p class="prop-desc">{prop.description}</p>
        </div>
      ))}
    </div>

    <!-- 3-Box Interactive Feature Grid -->
    <div class="features-intro">
      <span class="badge-pill badge-peach">Why Pakistani Students Trust Us</span>
      <h3 class="features-title">
        Bridging the Divide with <span class="italic-serif">Open Access Education</span>
      </h3>
    </div>

    <div class="features-grid">
      {FEATURE_HIGHLIGHTS.map((feat, idx) => {
        const badgeColors = ['badge-green', 'badge-blue', 'badge-pink'];
        const badgeClass = badgeColors[idx % badgeColors.length];
        return (
          <div class="feature-box vellum-card">
            <div class="feature-top">
              <span class={`badge-pill ${badgeClass}`}>Feature 0{idx + 1}</span>
            </div>
            <h4 class="feature-name">{feat.title}</h4>
            <p class="feature-text">{feat.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .value-props-section {
    background-color: var(--color-peach-light);
    border-top: 1px solid var(--color-vellum-border);
    border-bottom: 1px solid var(--color-vellum-border);
    padding: 80px 0 90px;
  }

  .props-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-bottom: 70px;
  }

  .prop-card {
    background: var(--color-surface);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-lg);
    padding: 36px 38px;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-normal);
  }

  .prop-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .prop-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-brand-blue, #555de3);
    line-height: 1;
    margin-bottom: 14px;
    opacity: 0.95;
  }

  .prop-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 12px;
  }

  .prop-desc {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Features Sub-section */
  .features-intro {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 40px;
  }

  .features-intro .badge-pill {
    margin-bottom: 12px;
  }

  .features-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 800;
    color: var(--color-text-main);
    line-height: 1.2;
  }

  .features-title .italic-serif {
    color: var(--color-brand-blue, #555de3);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-box {
    background: var(--color-surface);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-lg);
    padding: 28px 26px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal);
  }

  .feature-box:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .feature-top {
    margin-bottom: 14px;
  }

  .feature-name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 10px;
  }

  .feature-text {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .props-grid,
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
