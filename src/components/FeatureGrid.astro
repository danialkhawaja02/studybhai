---
import { VALUE_PROPOSITIONS, FEATURE_HIGHLIGHTS } from '@/lib/constants';
---

<section class="features-section" id="features">
  <div class="container">
    <!-- Value Propositions (01 / 02) -->
    <div class="value-props-grid">
      {VALUE_PROPOSITIONS.map((prop) => (
        <div class="value-prop-card card-premium">
          <div class="value-prop-number">{prop.number}</div>
          <h2 class="value-prop-title">{prop.title}</h2>
          <p class="value-prop-desc">{prop.description}</p>
        </div>
      ))}
    </div>

    <!-- Unlock Your Full Potential Heading -->
    <div class="section-header">
      <span class="badge badge-brand">Everything You Need</span>
      <h2 class="section-title">Unlock Your Full Potential with Study Bhai</h2>
      <p class="section-subtitle">
        Tailored revision notes, board syllabus books, and academic guides designed to maximize your exam scores.
      </p>
    </div>

    <!-- 3 Core Feature Highlights -->
    <div class="features-grid grid-3col">
      {FEATURE_HIGHLIGHTS.map((feature) => (
        <div class="feature-card card-premium">
          <div class="feature-icon-box">
            {feature.icon === 'star' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            )}
            {feature.icon === 'book-open' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            )}
            {feature.icon === 'users' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            )}
          </div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- Tutor / Online Guidance Callout Banner -->
    <div class="guidance-banner">
      <div class="guidance-content">
        <h3 class="guidance-title">We help you find the perfect study materials. It's completely free.</h3>
        <p class="guidance-desc">Explore verified board textbooks and chapter notes curated by top Pakistani educators.</p>
      </div>
      <div class="guidance-action">
        <a href="/books/" class="btn btn-primary btn-lg">
          <span>Explore All Books</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 5rem 0;
    background: #FFFFFF;
  }

  /* Value Props */
  .value-props-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-bottom: 5rem;
  }

  @media (max-width: 768px) {
    .value-props-grid {
      grid-template-columns: 1fr;
    }
  }

  .value-prop-card {
    padding: 2.5rem;
    position: relative;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
  }

  .value-prop-number {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-brand);
    opacity: 0.85;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .value-prop-title {
    font-size: 1.45rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }

  .value-prop-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 0;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem auto;
  }

  .section-title {
    font-size: 2.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  /* Feature Grid */
  .features-grid {
    margin-bottom: 4rem;
  }

  .feature-card {
    padding: 2.25rem;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
  }

  .feature-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--color-brand-subtle);
    color: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.65rem;
  }

  .feature-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Guidance Banner */
  .guidance-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #1F2E2B 0%, #152220 100%);
    border-radius: var(--radius-xl);
    padding: 2.5rem 3rem;
    color: #FFFFFF;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .guidance-content {
    max-width: 600px;
  }

  .guidance-title {
    font-size: 1.5rem;
    color: #FFFFFF;
    margin-bottom: 0.4rem;
  }

  .guidance-desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.95rem;
    margin-bottom: 0;
  }
</style>
