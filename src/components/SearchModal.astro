---
// src/components/SearchModal.astro
---

<div id="search-modal" class="search-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search educational resources">
  <div class="search-modal-card">
    <!-- Header with Search Input -->
    <div class="search-input-wrapper">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="Search books, notes, past papers, guides..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="esc-badge" id="search-close-btn" title="Press Escape to close">ESC</kbd>
    </div>

    <!-- Quick suggestions pills -->
    <div class="search-pills-bar">
      <span class="pills-label">Suggestions:</span>
      <button type="button" class="search-pill-btn" data-query="Physics">Physics</button>
      <button type="button" class="search-pill-btn" data-query="Class 12">Class 12</button>
      <button type="button" class="search-pill-btn" data-query="Biology">Biology</button>
      <button type="button" class="search-pill-btn" data-query="Past Papers">Past Papers</button>
      <button type="button" class="search-pill-btn" data-query="Scholarship">Scholarship</button>
    </div>

    <!-- Results Container -->
    <div class="search-results-container" id="search-results-list" role="listbox">
      <div class="search-placeholder-state" id="search-empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="placeholder-icon">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <p class="placeholder-title">Type a topic, book, or grade to search</p>
        <p class="placeholder-subtitle">Instant offline search across 500+ verified notes and Punjab Board textbooks</p>
      </div>

      <div class="search-loading-state" id="search-loading" style="display: none;">
        <div class="search-spinner"></div>
        <span>Searching resources...</span>
      </div>

      <div class="search-items-list" id="search-items" style="display: none;"></div>

      <div class="search-not-found" id="search-not-found" style="display: none;">
        <p class="not-found-title">No resources found for "<span id="search-query-display"></span>"</p>
        <p class="not-found-desc">Try checking for typos or searching by grade (e.g., "Class 10") or subject name.</p>
      </div>
    </div>

    <!-- Footer Controls -->
    <div class="search-modal-footer">
      <div class="footer-shortcuts">
        <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span><kbd>↵</kbd> Open</span>
        <span><kbd>ESC</kbd> Close</span>
      </div>
      <div class="footer-branding">
        <span>Powered by Study Bhai FastSearch</span>
      </div>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(10, 18, 16, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 80px 20px 40px;
    opacity: 0;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-modal-backdrop.is-open {
    display: flex;
    opacity: 1;
  }

  .search-modal-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    width: 100%;
    max-width: 640px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(5, 150, 105, 0.15);
    overflow: hidden;
    animation: modalSlideDown 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 140px);
  }

  @keyframes modalSlideDown {
    from {
      opacity: 0;
      transform: translateY(-16px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    background: var(--color-surface);
  }

  .search-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1.05rem;
    font-family: inherit;
    color: var(--color-text-main);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .esc-badge {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    cursor: pointer;
    user-select: none;
    transition: all 0.15s ease;
  }

  .esc-badge:hover {
    color: var(--color-text-main);
    border-color: var(--color-primary);
  }

  .search-pills-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .search-pills-bar::-webkit-scrollbar {
    display: none;
  }

  .pills-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .search-pill-btn {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .search-pill-btn:hover {
    background: rgba(5, 150, 105, 0.08);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .search-results-container {
    overflow-y: auto;
    padding: 12px 16px;
    min-height: 220px;
    flex: 1;
  }

  .search-placeholder-state,
  .search-loading-state,
  .search-not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    color: var(--color-text-muted);
  }

  .placeholder-icon {
    stroke: var(--color-border);
    margin-bottom: 12px;
  }

  .placeholder-title {
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0 0 6px 0;
  }

  .placeholder-subtitle,
  .not-found-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 400px;
  }

  .search-loading-state {
    gap: 12px;
    font-size: 0.9rem;
  }

  .search-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .not-found-title {
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0 0 6px 0;
  }

  .search-items-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.search-result-row) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  :global(.search-result-row:hover),
  :global(.search-result-row.is-selected) {
    background: rgba(5, 150, 105, 0.08);
    border-color: rgba(5, 150, 105, 0.25);
  }

  :global(.search-result-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  :global(.search-result-title) {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  :global(.search-result-badge) {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: rgba(5, 150, 105, 0.12);
    color: var(--color-primary);
    white-space: nowrap;
  }

  :global(.search-result-excerpt) {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  :global(.search-result-excerpt mark) {
    background: rgba(245, 158, 11, 0.25);
    color: var(--color-accent-amber);
    font-weight: 600;
    border-radius: 2px;
    padding: 0 2px;
  }

  .search-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .footer-shortcuts {
    display: flex;
    gap: 12px;
  }

  .footer-shortcuts kbd {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1px 5px;
    font-size: 0.72rem;
    margin-right: 2px;
  }

  @media (max-width: 640px) {
    .search-modal-backdrop {
      padding: 20px 12px;
    }
    .footer-shortcuts {
      display: none;
    }
  }
</style>

<script>
  // Client-side search with /api/search.json index and optional Pagefind deep search
  let searchIndexData: any[] | null = null;
  let isIndexLoaded = false;
  let pagefindInstance: any = null;
  let isPagefindLoaded = false;
  let activeIndex = -1;

  async function loadSearchIndex() {
    if (isIndexLoaded) return;
    try {
      const res = await fetch('/api/search.json');
      if (res.ok) {
        searchIndexData = await res.json();
        isIndexLoaded = true;
      }
    } catch {
      isIndexLoaded = false;
    }
  }

  async function loadPagefind() {
    if (isPagefindLoaded) return;
    try {
      // In production built static site, Pagefind is served from /pagefind/pagefind.js
      const pagefindUrl = '/pagefind/pagefind.js';
      pagefindInstance = await import(/* @vite-ignore */ pagefindUrl);
      await pagefindInstance.init();
      isPagefindLoaded = true;
    } catch {
      isPagefindLoaded = false;
    }
  }

  // Preload search index in the background
  loadSearchIndex();

  function initSearchModal() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    const closeBtn = document.getElementById('search-close-btn');
    const resultsContainer = document.getElementById('search-items');
    const emptyState = document.getElementById('search-empty-state');
    const notFoundState = document.getElementById('search-not-found');
    const loadingState = document.getElementById('search-loading');
    const queryDisplay = document.getElementById('search-query-display');

    if (!modal || !input) return;

    function openModal() {
      modal?.classList.add('is-open');
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        input.focus();
        input.select();
      }, 50);
      loadSearchIndex();
      loadPagefind();
    }

    function closeModal() {
      modal?.classList.remove('is-open');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      input.value = '';
      resetResults();
    }

    function resetResults() {
      if (resultsContainer) {
        resultsContainer.innerHTML = '';
        resultsContainer.style.display = 'none';
      }
      if (emptyState) emptyState.style.display = 'flex';
      if (notFoundState) notFoundState.style.display = 'none';
      if (loadingState) loadingState.style.display = 'none';
      activeIndex = -1;
    }

    // Bind triggers across the page
    document.querySelectorAll('[data-open-search]').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Keyboard shortcuts: Ctrl+K, Cmd+K, '/'
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        if (modal.classList.contains('is-open')) {
          closeModal();
        } else {
          openModal();
        }
      } else if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        e.preventDefault();
        closeModal();
      } else if (e.key === '/' && !modal.classList.contains('is-open')) {
        const target = e.target as HTMLElement;
        if (target && !['INPUT', 'TEXTAREA'].includes(target.tagName)) {
          e.preventDefault();
          openModal();
        }
      }
    });

    // Arrow navigation
    input.addEventListener('keydown', (e) => {
      const items = resultsContainer?.querySelectorAll('.search-result-row');
      if (!items || items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % items.length;
        updateSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateSelection(items);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && items[activeIndex]) {
          (items[activeIndex] as HTMLAnchorElement).click();
        }
      }
    });

    function updateSelection(items: NodeListOf<Element>) {
      items.forEach((item, idx) => {
        if (idx === activeIndex) {
          item.classList.add('is-selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('is-selected');
        }
      });
    }

    // Debounced search execution
    let searchTimeout: any;
    input.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      const query = input.value.trim();
      if (!query) {
        resetResults();
        return;
      }

      if (emptyState) emptyState.style.display = 'none';
      if (loadingState) loadingState.style.display = 'flex';
      if (resultsContainer) resultsContainer.style.display = 'none';
      if (notFoundState) notFoundState.style.display = 'none';

      searchTimeout = setTimeout(async () => {
        await executeSearch(query);
      }, 100);
    });

    // Quick suggestion pills
    document.querySelectorAll('.search-pill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const query = btn.getAttribute('data-query') || '';
        input.value = query;
        input.dispatchEvent(new Event('input'));
      });
    });

    async function executeSearch(query: string) {
      if (loadingState) loadingState.style.display = 'none';
      activeIndex = -1;

      let results: any[] = [];

      // 1. If Pagefind is available (e.g. in production), try pagefind first
      if (pagefindInstance && typeof pagefindInstance.search === 'function') {
        try {
          const searchResponse = await pagefindInstance.search(query);
          const rawResults = await Promise.all(
            searchResponse.results.slice(0, 10).map((r: any) => r.data())
          );
          results = rawResults.map((r: any) => ({
            url: r.url,
            title: r.meta?.title || 'Resource',
            excerpt: r.excerpt || '',
            category: r.filters?.category || 'Study Material'
          }));
        } catch {
          results = [];
        }
      }

      // 2. High-speed client-side search across all live posts and pages
      if (results.length === 0 && (!searchIndexData || searchIndexData.length === 0)) {
        await loadSearchIndex();
      }

      if (results.length === 0 && searchIndexData && searchIndexData.length > 0) {
        const qLower = query.toLowerCase().trim();
        const tokens = qLower.split(/\s+/).filter(Boolean);

        const scored = searchIndexData.map(item => {
          const titleLower = (item.title || '').toLowerCase();
          const excerptLower = (item.excerpt || '').toLowerCase();
          const categoryLower = (item.category || '').toLowerCase();
          const gradeLower = (item.grade || '').toLowerCase();
          const subjectLower = (item.subject || '').toLowerCase();

          let score = 0;
          if (titleLower === qLower) score += 120;
          if (titleLower.startsWith(qLower)) score += 60;
          if (titleLower.includes(qLower)) score += 35;

          // Check token matches
          let matchedTokens = 0;
          for (const token of tokens) {
            if (titleLower.includes(token)) {
              score += 15;
              matchedTokens++;
            } else if (gradeLower.includes(token) || subjectLower.includes(token)) {
              score += 12;
              matchedTokens++;
            } else if (categoryLower.includes(token)) {
              score += 8;
              matchedTokens++;
            } else if (excerptLower.includes(token)) {
              score += 4;
              matchedTokens++;
            }
          }

          if (matchedTokens === tokens.length) score += 20;

          return { item, score };
        });

        results = scored
          .filter(s => s.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 10)
          .map(s => s.item);
      }

      if (results.length === 0) {
        if (resultsContainer) resultsContainer.style.display = 'none';
        if (notFoundState) notFoundState.style.display = 'flex';
        if (queryDisplay) queryDisplay.textContent = query;
      } else {
        if (notFoundState) notFoundState.style.display = 'none';
        if (resultsContainer) {
          resultsContainer.innerHTML = results.map((item, idx) => `
            <a href="${item.url}" class="search-result-row" data-index="${idx}">
              <div class="search-result-top">
                <span class="search-result-title">${item.title}</span>
                <span class="search-result-badge">${item.category}</span>
              </div>
              <div class="search-result-excerpt">${item.excerpt}</div>
            </a>
          `).join('');
          resultsContainer.style.display = 'flex';
        }
      }
    }
  }

  // Initialize on initial page load and Astro view transitions
  initSearchModal();
  document.addEventListener('astro:page-load', initSearchModal);
</script>
