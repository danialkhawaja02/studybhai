---
import { HERO_STATS, GRADE_FILTERS } from '@/lib/constants';
---

<section class="hero-section">
  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-1"></div>
  <div class="ambient-glow glow-2"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- SDG Goal 4 Badge -->
      <div class="hero-badge-wrap">
        <span class="badge badge-gold">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          UN SDG Goal 4: Quality Education
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        Quality Education for <span class="highlight-text">Pakistani Students</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle">
        Free official Punjab Textbook Board (PTB) books, chapter revision notes, board past papers, and university admission test guides tailored for high school and intermediate success.
      </p>

      <!-- Instant Search Bar in Hero -->
      <div class="hero-search-wrapper" id="hero-search-box">
        <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          placeholder="Search notes, textbooks, past papers (e.g. Class 12 Math)..." 
          class="hero-search-input"
          readonly
        />
        <button class="hero-search-action-btn" aria-label="Open search">
          <span>Search</span>
          <kbd>Ctrl K</kbd>
        </button>
      </div>

      <!-- Quick Grade Selector Chips -->
      <div class="grade-selector-wrap">
        <span class="grade-label">Quick Jump:</span>
        <div class="grade-chips">
          {GRADE_FILTERS.map((item) => (
            <a href={`/books/${item.slug}/`} class="grade-pill">
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <!-- CTA Action Row -->
      <div class="hero-cta-row">
        <a href="#featured-resources" class="btn btn-primary btn-lg">
          <span>Get Started Free</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
        <a 
          href="https://youtu.be/-ZXiGDLi5LM?si=LGrQV-STOMzVEuJ8" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="video-btn"
        >
          <div class="play-icon-wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
          <span class="video-btn-text">How it works</span>
        </a>
      </div>

      <!-- Live Statistics Counter -->
      <div class="hero-stats-card">
        {HERO_STATS.map((stat, index) => (
          <div class="stat-item">
            <div class="stat-number">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
            {index < HERO_STATS.length - 1 && <div class="stat-divider"></div>}
          </div>
        ))}
      </div>
    </div>

    <!-- Hero Visual / Illustration -->
    <div class="hero-visual">
      <div class="visual-card-wrap">
        <div class="visual-card-glow"></div>
        <div class="visual-card">
          <div class="visual-header">
            <div class="badge badge-brand">Curriculum Verified</div>
            <span class="visual-grade">HSSC / SSC</span>
          </div>
          <div class="visual-illustration">
            <div class="floating-badge badge-top">
              <span class="star-icon">★</span>
              <span>100% Free Downloads</span>
            </div>
            <div class="book-mockup">
              <div class="book-spine"></div>
              <div class="book-cover">
                <div class="book-board">Punjab Board (PTB)</div>
                <div class="book-title">Mathematics & Sciences</div>
                <div class="book-class">Classes 9, 10, 11 & 12</div>
                <div class="book-badge">New Edition</div>
              </div>
            </div>
            <div class="floating-badge badge-bottom">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>500K+ Students Helped</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: linear-gradient(180deg, #1F2E2B 0%, #152220 100%);
    color: #FFFFFF;
    padding: 4.5rem 0 5.5rem 0;
    overflow: hidden;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    opacity: 0.25;
  }

  .glow-1 {
    width: 500px;
    height: 500px;
    background: #059669;
    top: -100px;
    left: -100px;
  }

  .glow-2 {
    width: 450px;
    height: 450px;
    background: #10B981;
    bottom: -150px;
    right: -100px;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  @media (max-width: 991px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
    }
  }

  .hero-badge-wrap {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.15;
    color: #FFFFFF;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .highlight-text {
    background: linear-gradient(135deg, #34D399 0%, #10B981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.25rem;
    }
  }

  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 2rem;
    max-width: 580px;
  }

  @media (max-width: 991px) {
    .hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Hero Search */
  .hero-search-wrapper {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.35rem 0.35rem 1.25rem;
    margin-bottom: 1.75rem;
    max-width: 580px;
    backdrop-filter: blur(8px);
    transition: all var(--transition-normal);
    cursor: pointer;
  }

  .hero-search-wrapper:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(5, 150, 105, 0.6);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .search-input-icon {
    color: #34D399;
    margin-right: 0.75rem;
    flex-shrink: 0;
  }

  .hero-search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 0.95rem;
    outline: none;
    cursor: pointer;
  }

  .hero-search-input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .hero-search-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-brand);
    color: #FFFFFF;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-full);
    border: none;
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .hero-search-action-btn:hover {
    background: var(--color-brand-hover);
  }

  .hero-search-action-btn kbd {
    background: rgba(0, 0, 0, 0.2);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.72rem;
  }

  @media (max-width: 640px) {
    .hero-search-action-btn kbd {
      display: none;
    }
  }

  /* Grade Chips */
  .grade-selector-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.25rem;
    flex-wrap: wrap;
  }

  @media (max-width: 991px) {
    .grade-selector-wrap {
      justify-content: center;
    }
  }

  .grade-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  .grade-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .grade-chips .grade-pill {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    padding: 0.35rem 0.95rem;
    font-size: 0.82rem;
  }

  .grade-chips .grade-pill:hover {
    background: var(--color-brand);
    border-color: var(--color-brand);
  }

  /* CTA Row */
  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.75rem;
  }

  @media (max-width: 991px) {
    .hero-cta-row {
      justify-content: center;
    }
  }

  .video-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .video-btn:hover {
    color: #34D399;
  }

  .play-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
  }

  .video-btn:hover .play-icon-wrap {
    background: var(--color-brand);
    border-color: var(--color-brand);
    transform: scale(1.08);
  }

  /* Stats Card */
  .hero-stats-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 1.25rem 2rem;
    max-width: 580px;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 991px) {
    .hero-stats-card {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .stat-item {
    position: relative;
    flex: 1;
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 700;
    color: #34D399;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .stat-divider {
    position: absolute;
    right: 0;
    top: 15%;
    height: 70%;
    width: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  /* Visual Card Mockup */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .visual-card-wrap {
    position: relative;
    width: 100%;
    max-width: 440px;
  }

  .visual-card-glow {
    position: absolute;
    inset: -10px;
    background: linear-gradient(135deg, rgba(5, 150, 105, 0.4) 0%, rgba(16, 185, 129, 0.1) 100%);
    filter: blur(24px);
    border-radius: var(--radius-xl);
    z-index: 0;
  }

  .visual-card {
    position: relative;
    z-index: 1;
    background: #253733;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .visual-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .visual-grade {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.05em;
  }

  .visual-illustration {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 0;
  }

  .book-mockup {
    position: relative;
    width: 200px;
    height: 270px;
    background: linear-gradient(135deg, #059669 0%, #064E3B 100%);
    border-radius: 4px 12px 12px 4px;
    box-shadow: -8px 8px 24px rgba(0, 0, 0, 0.4), inset -2px 0 6px rgba(255, 255, 255, 0.2);
    display: flex;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .book-spine {
    width: 14px;
    height: 100%;
    background: rgba(0, 0, 0, 0.25);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  .book-cover {
    flex: 1;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .book-board {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #FCD34D;
    font-weight: 700;
  }

  .book-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
  }

  .book-class {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .book-badge {
    align-self: flex-start;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: #FFFFFF;
  }

  .floating-badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #1A2624;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #FFFFFF;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }

  .badge-top {
    top: 0;
    left: 0;
    transform: rotate(-3deg);
  }

  .badge-top .star-icon {
    color: #F59E0B;
  }

  .badge-bottom {
    bottom: 0;
    right: 0;
    transform: rotate(3deg);
  }

  .badge-bottom svg {
    color: #10B981;
  }
</style>

<script>
  // Open search modal on clicking the hero search input
  const heroSearch = document.getElementById('hero-search-box');
  heroSearch?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search-modal'));
  });
</script>
