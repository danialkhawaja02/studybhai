---
// src/components/Hero.astro
const SHOWCASE_CARDS = [
  {
    grade: 'Class 9',
    tagClass: 'badge-green',
    subject: 'Physics Notes',
    desc: 'Solved numericals, MCQs & formula sheets',
    link: '/class-9-physics-notes/',
    icon: '⚡'
  },
  {
    grade: 'Class 10',
    tagClass: 'badge-blue',
    subject: 'Biology Textbook',
    desc: 'Official PTB textbook in high-res PDF',
    link: '/class-10-biology-ptb-book/',
    icon: '🔬'
  },
  {
    grade: 'Class 11',
    tagClass: 'badge-lavender',
    subject: 'English Grammar',
    desc: 'PCTB textbook & model examination papers',
    link: '/class-11-english-ptb-book/',
    icon: '📖'
  },
  {
    grade: 'Class 12',
    tagClass: 'badge-blue',
    subject: 'Mathematics Solved',
    desc: 'Chapter-wise step-by-step calculus notes',
    link: '/class-12-math-notes/',
    icon: '📐'
  }
];

const GRADE_PILLS = [
  { label: '9th Class', href: '/books/class-9/' },
  { label: '10th Matric', href: '/books/class-10/' },
  { label: '11th FSc', href: '/books/class-11/' },
  { label: '12th Inter', href: '/books/class-12/' },
];
---

<section class="hero-wine-section">
  <div class="container hero-container">
    <div class="hero-content">
      <!-- UN SDG 4 Badge -->
      <div class="hero-eyebrow">
        <span class="eyebrow-icon">🎯</span>
        <span class="eyebrow-text">UN SDG 4: Quality Education for All Pakistani Students</span>
      </div>

      <!-- Main Headline with Italic Serif Accent -->
      <h1 class="hero-title">
        Quality Education for <span class="italic-serif">Pakistani Students</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-lead">
        Study Bhai gives high school and college students completely free access to official Punjab Curriculum textbooks (PCTB), board position holder notes, and past examination papers.
      </p>

      <!-- Integrated Search Trigger Box -->
      <div class="hero-search-wrapper" data-open-search>
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          class="hero-search-input"
          placeholder="Search 500+ books, notes, or board subjects..."
          readonly
        />
        <button type="button" class="btn-hero-search">
          <span>Search</span>
          <kbd class="kbd-shortcut">⌘K</kbd>
        </button>
      </div>

      <!-- Grade Filter Quick Pills -->
      <div class="hero-pills-row">
        <span class="pills-title">Quick Access:</span>
        <div class="pills-list">
          {GRADE_PILLS.map(pill => (
            <a href={pill.href} class="hero-grade-chip">{pill.label}</a>
          ))}
        </div>
      </div>

      <!-- Live Metrics Bar -->
      <div class="hero-metrics-pill">
        <div class="metric-block">
          <span class="metric-num">500K+</span>
          <span class="metric-label">Students Guided</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-block">
          <span class="metric-num">15+</span>
          <span class="metric-label">Subjects Covered</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-block">
          <span class="metric-num">100%</span>
          <span class="metric-label">Free Forever</span>
        </div>
      </div>
    </div>

    <!-- Right Side: Interactive 4-Card Floating Showcase -->
    <div class="hero-cards-showcase">
      <div class="showcase-glow-circle"></div>
      <div class="showcase-grid">
        {SHOWCASE_CARDS.map((card, idx) => (
          <a
            href={card.link}
            class={`hero-showcase-card card-pos-${idx + 1}`}
          >
            <div class="card-top">
              <span class={`badge-pill ${card.tagClass}`}>{card.grade}</span>
              <span class="card-icon">{card.icon}</span>
            </div>
            <h3 class="card-subject">{card.subject}</h3>
            <p class="card-desc">{card.desc}</p>
            <div class="card-action">
              <span>View Free Material</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-wine-section {
    background: radial-gradient(circle at 75% 20%, rgba(85, 93, 227, 0.18) 0%, transparent 55%),
                linear-gradient(180deg, var(--color-navy, #1e2454) 0%, var(--color-navy-dark, #131738) 100%);
    color: #ffffff;
    padding: 70px 0 90px;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Eyebrow */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(85, 93, 227, 0.16);
    border: 1px solid rgba(182, 219, 255, 0.3);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: #b6dbff;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  /* Title */
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }

  .hero-title .italic-serif {
    color: #8c92ff;
    font-weight: 500;
  }

  /* Lead */
  .hero-lead {
    font-size: 1.12rem;
    line-height: 1.65;
    color: #e2e8f0;
    max-width: 560px;
    margin-bottom: 32px;
    opacity: 0.95;
  }

  /* Search Box */
  .hero-search-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 540px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(182, 219, 255, 0.25);
    border-radius: var(--radius-lg);
    padding: 8px 12px 8px 18px;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    transition: all var(--transition-normal);
    margin-bottom: 22px;
  }

  .hero-search-wrapper:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--color-brand-blue, #555de3);
    box-shadow: 0 12px 30px rgba(19, 23, 56, 0.5);
  }

  .search-icon {
    color: var(--color-brand-blue, #555de3);
    flex-shrink: 0;
  }

  .hero-search-input {
    flex: 1;
    border: none;
    background: transparent;
    color: #ffffff;
    font-size: 0.96rem;
    outline: none;
    cursor: pointer;
  }

  .hero-search-input::placeholder {
    color: rgba(226, 232, 240, 0.65);
  }

  .btn-hero-search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-brand-blue, #555de3);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-md);
    padding: 8px 16px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-hero-search:hover {
    background: var(--color-brand-blue-hover, #434bc9);
    box-shadow: 0 4px 12px rgba(85, 93, 227, 0.35);
  }

  .kbd-shortcut {
    background: rgba(0, 0, 0, 0.25);
    padding: 2px 5px;
    border-radius: 3px;
    font-size: 0.72rem;
  }

  /* Quick Pills */
  .hero-pills-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .pills-title {
    font-size: 0.82rem;
    color: rgba(226, 232, 240, 0.75);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pills-list {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hero-grade-chip {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(182, 219, 255, 0.25);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .hero-grade-chip:hover {
    background: var(--color-brand-blue, #555de3);
    color: #ffffff;
    border-color: var(--color-brand-blue, #555de3);
  }

  /* Metrics Pill */
  .hero-metrics-pill {
    display: flex;
    align-items: center;
    gap: 24px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(182, 219, 255, 0.2);
    border-radius: var(--radius-lg);
    padding: 14px 28px;
    backdrop-filter: blur(8px);
  }

  .metric-block {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .metric-num {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 800;
    color: #8c92ff;
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.75rem;
    color: #cbd5e1;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .metric-divider {
    width: 1px;
    height: 32px;
    background: rgba(182, 219, 255, 0.2);
  }

  /* Right Side: Interactive 4-Card Showcase */
  .hero-cards-showcase {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .showcase-glow-circle {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(85, 93, 227, 0.25) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    filter: blur(20px);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    width: 100%;
    max-width: 480px;
    position: relative;
    z-index: 2;
  }

  .hero-showcase-card {
    background: var(--color-surface);
    border: 1px solid var(--color-vellum-border);
    border-radius: var(--radius-lg);
    padding: 18px;
    color: var(--color-text-main);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .card-pos-1 { animation: float 4s ease-in-out infinite; }
  .card-pos-2 { animation: float 4.4s ease-in-out infinite 0.5s; }
  .card-pos-3 { animation: float 4.2s ease-in-out infinite 1s; }
  .card-pos-4 { animation: float 4.6s ease-in-out infinite 1.5s; }

  .hero-showcase-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.35);
    border-color: var(--color-brand-blue, #555de3);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .card-icon {
    font-size: 1.2rem;
  }

  .card-subject {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 6px;
    line-height: 1.25;
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin-bottom: 14px;
    flex: 1;
  }

  .card-action {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-brand-blue, #555de3);
    border-top: 1px solid var(--color-vellum-border);
    padding-top: 10px;
    transition: gap var(--transition-fast);
  }

  .hero-showcase-card:hover .card-action {
    gap: 10px;
  }

  @media (max-width: 990px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }

    .hero-content {
      align-items: center;
    }

    .hero-lead {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-pills-row {
      justify-content: center;
    }

    .showcase-grid {
      margin: 0 auto;
    }
  }

  @media (max-width: 540px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }

    .hero-metrics-pill {
      flex-direction: column;
      gap: 14px;
      width: 100%;
    }

    .metric-divider {
      width: 100%;
      height: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-showcase-card {
      animation: none !important;
    }
  }
</style>
