---
// src/components/WhatsAppBanner.astro
---

<section class="help-cta-section">
  <div class="container">
    <div class="help-links-row">
      <a href="/contact/" class="help-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Looking for help? <strong>Contact us today</strong></span>
      </a>
      <a href="https://instagram.com/studybhai" target="_blank" rel="noopener noreferrer" class="help-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        <span>Simple Touch: <strong>Follow us on Instagram</strong></span>
      </a>
    </div>

    <div class="whatsapp-banner">
      <div class="whatsapp-banner-content">
        <div class="whatsapp-icon-circle">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <span class="whatsapp-text">Contact us on Whatsapp for any help!</span>
      </div>
      <a href="https://wa.me/923000000000" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-connect">
        <span>Connect Now</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .help-cta-section {
    padding: 30px 0 65px;
    background-color: #ffffff;
  }

  .help-links-row {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .help-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .help-link:hover {
    color: var(--color-brand-blue, #555de3);
  }

  .help-link strong {
    color: var(--color-navy, #1e2454);
    font-weight: 700;
  }

  .whatsapp-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(90deg, #555de3 0%, #6870f2 100%);
    border-radius: var(--radius-xl);
    padding: 22px 36px;
    color: #ffffff;
    box-shadow: 0 12px 28px -6px rgba(85, 93, 227, 0.4);
    flex-wrap: wrap;
    gap: 20px;
  }

  .whatsapp-banner-content {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .whatsapp-icon-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .whatsapp-text {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .btn-whatsapp-connect {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #131738;
    color: #ffffff;
    padding: 12px 28px;
    border-radius: var(--radius-full);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-whatsapp-connect:hover {
    background: #1e2454;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(19, 23, 56, 0.35);
  }

  @media (max-width: 768px) {
    .whatsapp-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }

    .help-links-row {
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
  }
</style>
