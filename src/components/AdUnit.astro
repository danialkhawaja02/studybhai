---
// src/components/AdUnit.astro
interface Props {
  slotId?: string;
  format?: 'auto' | 'horizontal' | 'rectangle' | 'vertical';
  client?: string;
  className?: string;
}

const {
  slotId = '1234567890',
  format = 'auto',
  client = 'ca-pub-XXXXXXXXXXXXXXXX',
  className = ''
} = Astro.props;

// Determine minimum height based on format to eliminate CLS (Cumulative Layout Shift)
const minHeight = format === 'rectangle' ? '280px' : format === 'horizontal' ? '90px' : '100px';
---

<div class={`ad-container-wrapper ${className}`} style={`min-height: ${minHeight};`}>
  <div class="ad-label">Advertisement</div>
  <div class="ad-slot" data-format={format}>
    <!-- Google AdSense Unit (Zero-CLS pre-allocated placeholder) -->
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
  </div>
</div>

<style>
  .ad-container-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 24px 0;
    padding: 12px 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    contain: layout;
  }

  .ad-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 6px;
    opacity: 0.6;
    user-select: none;
  }

  .ad-slot {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ad-slot[data-format="rectangle"] {
    max-width: 336px;
  }

  .ad-slot[data-format="horizontal"] {
    max-width: 728px;
  }
</style>

<script>
  // Asynchronously trigger adsbygoogle push when ad element is visible in viewport
  function initAdSense() {
    try {
      const ads = document.querySelectorAll('.adsbygoogle:not([data-adsbygoogle-status])');
      if (ads.length > 0 && (window as any).adsbygoogle) {
        ads.forEach(() => {
          ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});
        });
      }
    } catch {
      // Gracefully silent if AdSense script is blocked by client ad-blocker
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdSense);
  } else {
    initAdSense();
  }
</script>
