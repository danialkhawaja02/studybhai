---
import { generateSchemaOrg, type SeoOptions } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isArticle?: boolean;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
}

const {
  title = 'Study Bhai - Your Gateway to Quality Education for All Pakistani Students',
  description = 'Study Bhai is an online platform for Pakistani students offering free PTB books, chapter notes, past papers, and scholarship guides.',
  image = 'https://studybhai.com/wp-content/uploads/2024/03/demo-elearning-footer-bg.png',
  isArticle = false,
  datePublished,
  dateModified,
  authorName = 'Danial Sohail'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://studybhai.com').href;

const schemaData = generateSchemaOrg({
  title,
  description,
  isArticle,
  datePublished,
  dateModified,
  authorName,
  imageUrl: image,
  canonicalUrl
});
---

<!-- Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" sizes="32x32" href="https://studybhai.com/wp-content/uploads/2024/11/cropped-Study-Bhai-Logo-02-1-32x32.png" />
<link rel="apple-touch-icon" href="https://studybhai.com/wp-content/uploads/2024/11/cropped-Study-Bhai-Logo-02-1-180x180.png" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content="Study Bhai" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta name="twitter:site" content="@studybhai" />

<!-- JSON-LD Structured Schema -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
